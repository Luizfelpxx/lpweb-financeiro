# Copie este arquivo para .env.local (desenvolvimento) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
# NUNCA coloque valores reais neste arquivo nem faça commit do .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: usada SOMENTE no servidor (rota do cron). Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (crie o bot com o @BotFather e descubra o chat id com o @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Segredo da rota /api/cron/relatorio-diario (gere um valor longo e aleatório).
# A Vercel envia automaticamente "Authorization: Bearer <CRON_SECRET>" nas chamadas do cron.
CRON_SECRET=
